# =====================================================================
# CẤU HÌNH MÔI TRƯỜNG CLIENT FRONTEND (NEXT.JS)
# =====================================================================

# 1. Đường dẫn API kết nối tới Máy chủ Backend Express.js (kết thúc bằng /api)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# 2. Đường dẫn máy chủ Socket.IO Real-time (không có /api ở cuối)
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# 3. Google reCAPTCHA Site Key (Client-side)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
