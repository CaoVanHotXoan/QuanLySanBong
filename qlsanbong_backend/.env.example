# =====================================================================
# CẤU HÌNH MÁY CHỦ BACKEND (EXPRESS.JS)
# =====================================================================
PORT=5000

# =====================================================================
# CẤU HÌNH KẾT NỐI CƠ SỞ DỮ LIỆU SQL SERVER
# =====================================================================
DB_USER=sa
DB_PASSWORD=your_database_password
DB_SERVER=localhost
DB_DATABASE=QuanLySanBong
DB_PORT=1433
DB_ENCRYPT=false

# =====================================================================
# CẤU HÌNH XÁC THỰC BẢO MẬT (JWT TOKEN)
# =====================================================================
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# =====================================================================
# CẤU HÌNH CỔNG THANH TOÁN PAYOS (MB BANK VIETQR)
# =====================================================================
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# =====================================================================
# CẤU HÌNH FRONTEND URL
# =====================================================================
FRONTEND_URL=http://localhost:3000

# =====================================================================
# CẤU HÌNH CLOUDINARY (LƯU TRỮ HÌNH ẢNH & VIDEO)
# =====================================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# =====================================================================
# CẤU HÌNH GỬI EMAIL THÔNG BÁO (GMAIL SMTP)
# =====================================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_FROM="Soccer247 <no-reply@soccer247.vn>"
ADMIN_NOTIFICATION_EMAIL=your_admin_email@gmail.com
